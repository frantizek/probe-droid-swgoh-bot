# Token del bot de Discord (obtener desde Discord Developer Portal)
BOT_TOKEN=tu_token_de_bot_aqui

# ID del canal de Discord donde se enviarán todos los mensajes por default
GENERAL_CHANNEL_ID=0

# ID del canal de Discord donde se enviarán las alertas RSS
CODE_ALERTS_CHANNEL_ID=0

# ID del canal de Discord para órdenes de BT
BT_GUILD_ORDERS_CHANNEL_ID=0

# ID del canal de Discord para órdenes de GT
GT_GUILD_ORDERS_CHANNEL_ID=0

# MongoDB (para órdenes de Batalla Territorial)
MONGODB_URI=tu_mongodb_uri_aqui
MONGODB_DB_NAME=orders_manager
